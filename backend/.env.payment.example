# ============================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================

# STRIPE
# Get your API keys from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_your_stripe_api_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# MERCADO PAGO
# Get your access token from: https://www.mercadopago.com.br/developers/panel
MERCADO_PAGO_ACCESS_TOKEN=APP_USR_your_access_token_here
MERCADO_PAGO_WEBHOOK_TOKEN=your_webhook_token_here

# PAYPAL
# Get your credentials from: https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# PAYMENT SETTINGS
# Default payment provider (stripe, mercado_pago, paypal)
DEFAULT_PAYMENT_PROVIDER=stripe

# Enable/disable payment methods
ENABLE_CREDIT_CARD=true
ENABLE_DEBIT_CARD=true
ENABLE_PIX=true
ENABLE_BOLETO=true
ENABLE_BANK_TRANSFER=true
ENABLE_PAYPAL=true

# Payment settings
PAYMENT_TIMEOUT_SECONDS=300
PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_RETRY_DELAY_MS=1000

# Currency
PAYMENT_CURRENCY=BRL

# 3D Secure
ENABLE_3D_SECURE=true

# Webhook settings
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_RETRY_ATTEMPTS=5
WEBHOOK_RETRY_DELAY_MS=5000
